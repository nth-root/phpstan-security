includes:
    - config/taint/php.neon
    - config/taint/doctrine.neon
    - config/taint/symfony.neon
    - config/taint/laravel.neon

parametersSchema:
    taint: structure([
        sources: structure([
            variables: listOf(string()),
            methods: arrayOf(listOf(string())),
        ]),
        flows: structure([
            functions: arrayOf(listOf(string())),
        ]),
        sinks: structure([
            functions: arrayOf(structure([
                type: anyOf('sql', 'html', 'shell', 'include', 'path', 'redirect'),
                parameters: listOf(string()),
            ])),
            methods: arrayOf(arrayOf(structure([
                type: anyOf('sql', 'html', 'shell', 'include', 'path', 'redirect'),
                parameters: listOf(string()),
            ]))),
        ]),
    ])

services:
    - NthRoot\PhpstanSecurity\TaintAnalysis\ExpressionFlattener
    - NthRoot\PhpstanSecurity\TaintAnalysis\CallArguments
    - NthRoot\PhpstanSecurity\TaintAnalysis\Callees
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\TaintSpec
        arguments: [%taint%]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\EchoSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\PrintSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\ShellExecSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\FunctionCallSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\MethodCallSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\HeaderSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\IncludeSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\AssignmentCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\CallArgumentCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\SymfonyRouteParameterCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\CompoundAssignmentCollector
        tags: [phpstan.collector]

rules:
    - NthRoot\PhpstanSecurity\Rules\TaintRule
