includes:
    - config/taint/php.neon
    - config/taint/doctrine.neon
    - config/taint/symfony.neon
    - config/taint/laravel.neon

parametersSchema:
    taint: structure([
        sources: structure([
            variables: listOf(string()),
            methods: arrayOf(listOf(string())),
            excludeClasses: listOf(string()),
        ]),
        flows: structure([
            functions: arrayOf(structure([
                parameters: listOf(string()),
                ?sanitizes: listOf(anyOf('sql', 'html', 'shell', 'include', 'path', 'redirect', 'unserialize', 'callable', 'eval', 'xpath', 'ldap', 'template')),
                ?valuesOnly: bool(),
            ])),
        ]),
        sinks: structure([
            functions: arrayOf(structure([
                type: anyOf('sql', 'html', 'shell', 'include', 'path', 'redirect', 'unserialize', 'callable', 'eval', 'xpath', 'ldap', 'template'),
                parameters: listOf(string()),
            ])),
            methods: arrayOf(arrayOf(structure([
                type: anyOf('sql', 'html', 'shell', 'include', 'path', 'redirect', 'unserialize', 'callable', 'eval', 'xpath', 'ldap', 'template'),
                parameters: listOf(string()),
            ]))),
        ]),
    ])

services:
    - NthRoot\PhpstanSecurity\TaintAnalysis\ExpressionFlattener
    - NthRoot\PhpstanSecurity\TaintAnalysis\CallArguments
    - NthRoot\PhpstanSecurity\TaintAnalysis\Callees
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\TaintSpec
        arguments: [%taint%]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\EchoSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\PrintSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\ShellExecSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\FunctionCallSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\MethodCallSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\StaticCallSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\HeaderSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\IncludeSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\EvalSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Sink\InstantiationSinkCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Flow\AssignmentCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Flow\CallArgumentCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Flow\SymfonyRouteParameterCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Flow\CompoundAssignmentCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Flow\ReturnCollector
        tags: [phpstan.collector]
    -
        class: NthRoot\PhpstanSecurity\TaintAnalysis\Collector\Flow\ForeachCollector
        tags: [phpstan.collector]

rules:
    - NthRoot\PhpstanSecurity\Rules\TaintRule
