parameters:
    taint:
        sources:
            variables: [_GET, _POST, _REQUEST, _COOKIE]
            methods: []

        flows:
            functions:
                trim: {parameters: [string]}
                ltrim: {parameters: [string]}
                rtrim: {parameters: [string]}
                strtolower: {parameters: [string]}
                strtoupper: {parameters: [string]}
                str_replace: {parameters: [replace, subject]}
                sprintf: {parameters: [format, values]}
                implode: {parameters: [separator, array]}
                explode: {parameters: [string]}
                escapeshellcmd: {parameters: [command]}
                htmlspecialchars: {parameters: [string], sanitizes: [html]}
                htmlentities: {parameters: [string], sanitizes: [html]}
                escapeshellarg: {parameters: [arg], sanitizes: [shell]}
                ldap_escape: {parameters: [value], sanitizes: [ldap]}

        sinks:
            functions:
                exec: {type: shell, parameters: [command]}
                system: {type: shell, parameters: [command]}
                shell_exec: {type: shell, parameters: [command]}
                passthru: {type: shell, parameters: [command]}
                proc_open: {type: shell, parameters: [command]}
                popen: {type: shell, parameters: [command]}
                pcntl_exec: {type: shell, parameters: [path]}
                mail: {type: shell, parameters: [additional_params]}
                unserialize: {type: unserialize, parameters: [data]}
                call_user_func: {type: callable, parameters: [callback]}
                call_user_func_array: {type: callable, parameters: [callback]}
                ldap_search: {type: ldap, parameters: [base, filter]}
                ldap_list: {type: ldap, parameters: [base, filter]}
                ldap_read: {type: ldap, parameters: [base, filter]}
                printf: {type: html, parameters: [format, values]}
                vprintf: {type: html, parameters: [format, values]}
                mysqli_query: {type: sql, parameters: [query]}
                mysqli_real_query: {type: sql, parameters: [query]}
                mysqli_multi_query: {type: sql, parameters: [query]}
                mysqli_prepare: {type: sql, parameters: [query]}
                mysqli_execute_query: {type: sql, parameters: [query]}
                file_get_contents: {type: path, parameters: [filename]}
                file_put_contents: {type: path, parameters: [filename]}
                fopen: {type: path, parameters: [filename]}
                file: {type: path, parameters: [filename]}
                readfile: {type: path, parameters: [filename]}
                parse_ini_file: {type: path, parameters: [filename]}
                unlink: {type: path, parameters: [filename]}
                copy: {type: path, parameters: [from, to]}
                rename: {type: path, parameters: [from, to]}

            methods:
                PDO:
                    query: {type: sql, parameters: [query]}
                    exec: {type: sql, parameters: [statement]}
                    prepare: {type: sql, parameters: [query]}
                mysqli:
                    query: {type: sql, parameters: [query]}
                    real_query: {type: sql, parameters: [query]}
                    multi_query: {type: sql, parameters: [query]}
                    prepare: {type: sql, parameters: [query]}
                    execute_query: {type: sql, parameters: [query]}
                SQLite3:
                    query: {type: sql, parameters: [query]}
                    exec: {type: sql, parameters: [query]}
                    querySingle: {type: sql, parameters: [query]}
                    prepare: {type: sql, parameters: [query]}
                DOMXPath:
                    query: {type: xpath, parameters: [expression]}
                    evaluate: {type: xpath, parameters: [expression]}
                SimpleXMLElement:
                    xpath: {type: xpath, parameters: [expression]}
