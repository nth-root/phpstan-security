parameters:
    taint:
        sources:
            methods:
                Illuminate\Http\Request: [input, query, post, cookie, header, server, json, route, string, str, all, only, except, keys, segment, segments, path, decodedPath, url, fullUrl, fullUrlWithQuery, fullUrlWithoutQuery, host, httpHost, schemeAndHttpHost, root, userAgent, bearerToken, old]
                Illuminate\Support\Facades\Request: [input, query, post, cookie, header, server, json, route, string, str, all, only, except, keys, segment, segments, path, decodedPath, url, fullUrl, fullUrlWithQuery, fullUrlWithoutQuery, host, httpHost, schemeAndHttpHost, root, userAgent, bearerToken, old]
                Illuminate\Foundation\Http\FormRequest: [validated, safe]
                Illuminate\Support\ValidatedInput: [input, string, str, all, only, except, keys]

        flows:
            functions:
                e: {parameters: [value], sanitizes: [html]}
                data_get: {parameters: [target, default]}

        sinks:
            functions:
                redirect: {type: redirect, parameters: [to]}
                response: {type: html, parameters: [content]}

            methods:
                Illuminate\View\Compilers\BladeCompiler:
                    render: {type: template, parameters: [string]}
                    compileString: {type: template, parameters: [value]}
                Illuminate\Support\Facades\Blade:
                    render: {type: template, parameters: [string]}
                    compileString: {type: template, parameters: [value]}
                Illuminate\Process\PendingProcess:
                    command: {type: shell, parameters: [command]}
                    run: {type: shell, parameters: [command]}
                    start: {type: shell, parameters: [command]}
                Illuminate\Support\Facades\Process:
                    command: {type: shell, parameters: [command]}
                    run: {type: shell, parameters: [command]}
                    start: {type: shell, parameters: [command]}
                Illuminate\Routing\Redirector:
                    to: {type: redirect, parameters: [path]}
                    away: {type: redirect, parameters: [path]}
                Illuminate\Support\Facades\Redirect:
                    to: {type: redirect, parameters: [path]}
                    away: {type: redirect, parameters: [path]}
                Illuminate\Contracts\Filesystem\Filesystem:
                    get: {type: path, parameters: [path]}
                    put: {type: path, parameters: [path]}
                    putFileAs: {type: path, parameters: [path, name]}
                    delete: {type: path, parameters: [paths]}
                Illuminate\Support\Facades\Storage:
                    get: {type: path, parameters: [path]}
                    put: {type: path, parameters: [path]}
                    putFileAs: {type: path, parameters: [path, name]}
                    delete: {type: path, parameters: [paths]}
                Illuminate\Http\UploadedFile:
                    store: {type: path, parameters: [path]}
                    storePublicly: {type: path, parameters: [path]}
                    storeAs: {type: path, parameters: [path, name]}
                    storePubliclyAs: {type: path, parameters: [path, name]}
                Illuminate\Http\Response:
                    __construct: {type: html, parameters: [content]}
                Illuminate\Database\ConnectionInterface:
                    select: {type: sql, parameters: [query]}
                    selectOne: {type: sql, parameters: [query]}
                    cursor: {type: sql, parameters: [query]}
                    insert: {type: sql, parameters: [query]}
                    update: {type: sql, parameters: [query]}
                    delete: {type: sql, parameters: [query]}
                    statement: {type: sql, parameters: [query]}
                    affectingStatement: {type: sql, parameters: [query]}
                    unprepared: {type: sql, parameters: [query]}
                    raw: {type: sql, parameters: [value]}
                Illuminate\Support\Facades\DB:
                    select: {type: sql, parameters: [query]}
                    selectOne: {type: sql, parameters: [query]}
                    cursor: {type: sql, parameters: [query]}
                    insert: {type: sql, parameters: [query]}
                    update: {type: sql, parameters: [query]}
                    delete: {type: sql, parameters: [query]}
                    statement: {type: sql, parameters: [query]}
                    affectingStatement: {type: sql, parameters: [query]}
                    unprepared: {type: sql, parameters: [query]}
                    raw: {type: sql, parameters: [value]}
                Illuminate\Contracts\Database\Query\Builder:
                    whereRaw: {type: sql, parameters: [sql]}
                    orWhereRaw: {type: sql, parameters: [sql]}
                    havingRaw: {type: sql, parameters: [sql]}
                    orHavingRaw: {type: sql, parameters: [sql]}
                    orderByRaw: {type: sql, parameters: [sql]}
                    groupByRaw: {type: sql, parameters: [sql]}
                    selectRaw: {type: sql, parameters: [expression]}
                    fromRaw: {type: sql, parameters: [expression]}
