{
    "name": "nth-root/phpstan-security",
    "description": "A PHPStan extension that checks your code for security vulnerabilities",
    "license": "MIT",
    "type": "phpstan-extension",
    "keywords": [
        "phpstan",
        "security",
        "taint-analysis",
        "static-analysis"
    ],
    "require": {
        "php": "^8.2",
        "phpstan/phpstan": "^2.1.3"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/process": "^7.4",
        "symfony/routing": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "NthRoot\\PhpstanSecurity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/EndToEnd/data/src/",
            "NthRoot\\PhpstanSecurity\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Rules/data/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
