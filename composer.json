{
    "name": "nth-root/phpstan-security",
    "type": "phpstan-extension",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "phpstan/phpstan": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.4"
    },
    "autoload": {
        "psr-4": {
            "NthRoot\\PhpstanSecurity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NthRoot\\PhpstanSecurity\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
